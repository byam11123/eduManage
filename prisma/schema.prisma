// This is your Prisma schema file,
// learn more about it in docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  fullName      String
  password      String
  isVerified    Boolean  @default(false)
  image         String?
  googleId      String?  @unique
  emailVerified DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  otps          Otp[]
  passwordResets PasswordReset[]
  ownedOrganization  Organization?          @relation("OrganizationOwner")
  organizations    OrganizationMember[]
  userBranches     UserBranch[]

  @@index([email])
  @@index([googleId])
}

model Otp {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  // Relations
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String?

  @@index([email])
  @@index([code])
  @@index([expiresAt])
}

model PasswordReset {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  // Relations
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String?

  @@index([email])
  @@index([token])
  @@index([expiresAt])
}

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  logo        String?
  industry    String?
  size        String?  // Small, Medium, Large
  website     String?
  phone       String?
  email       String?
  address     String?
  city        String?
  state       String?
  country     String?
  zipCode     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  owner      User                @relation("OrganizationOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId    String   @unique
  members    OrganizationMember[]
  branches   Branch[]
  courses    Course[]
  enquiries  Enquiry[]

  @@index([slug])
  @@index([ownerId])
}

model OrganizationMember {
  id             String   @id @default(cuid())
  role           String   @default("member") // owner, admin, member
  status         String   @default("pending") // pending, active, inactive
  invitedAt      DateTime @default(now())
  joinedAt       DateTime?

  // Relations
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
}

model Branch {
  id            String   @id @default(cuid())
  name          String
  description   String?
  address       String?
  city          String?
  state         String?
  country       String?
  zipCode       String?
  phone         String?
  email         String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  userBranches  UserBranch[]
  students      Student[]
  enquiries     Enquiry[]

  @@index([organizationId])
}

model UserBranch {
  id            String   @id @default(cuid())
  role          String   @default("user") // super_admin, branch_admin, user
  isDefault     Boolean  @default(false)

  // Relations
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  branch        Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  branchId      String

  @@unique([userId, branchId])
  @@index([userId])
  @@index([branchId])
}

// Student model for coaching management
model Student {
  id            String   @id @default(cuid())
  firstName     String
  lastName      String
  email         String?
  phone         String?
  dateOfBirth   DateTime?
  gender        String?  // male, female, other
  address       String?
  city          String?
  state         String?
  country       String?
  zipCode       String?
  enrollmentNo  String?  @unique
  paymentStatus String   @default("pending") // paid, pending, partial, overdue
  enrollmentDate DateTime @default(now())
  status        String   @default("active") // active, inactive, graduated, dropped
  notes         String?
  
  // Admission Details
  fathersName    String?
  fathersPhone   String?
  mothersName    String?
  category       String?  // general, obc, sc, st, other
  maritalStatus  String?  // single, married, divorced, widowed
  aadhaarNumber  String? // 12 digit
  alternatePhone String?
  
  // Address Split
  addressLine1   String?
  addressLine2   String?
  district       String?
  
  imageUrl       String?
  schoolCollege  String?
  referredBy     String?
  
  // Qualification Details
  highestQualification String?
  hsSchoolName       String?
  hsBoard            String?
  hsPassingYear      String?
  hsPercentage       String?
  hssSchoolName      String?
  hssBoard           String?
  hssStream          String?
  hssPassingYear     String?
  hssPercentage      String?
  gradCollegeName    String?
  gradUniversity     String?
  gradDegree         String?
  gradPassingYear    String?
  gradPercentage     String?
  pgCollegeName      String?
  pgUniversity       String?
  pgDegree           String?
  pgPassingYear      String?
  pgPercentage       String?

  // Financial Details
  totalAmount     Float     @default(0)
  discountAmount  Float     @default(0)
  netPayableFee   Float     @default(0)
  isPartPayment   Boolean   @default(false)
  installmentPlan String?   // JSON string of InstallmentPlanItem[]
  installmentMode String?   // 'preset' | 'equal' | 'custom'
  fullPayment     String?   // JSON string of full payment details
  receivedBy      String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations - IMPORTANT: Each student belongs to ONE branch
  branch        Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  branchId      String
  course        Course?  @relation(fields: [courseId], references: [id])
  courseId      String?
  batch         Batch?   @relation(fields: [batchId], references: [id])
  batchId       String?

  @@index([branchId])
  @@index([courseId])
  @@index([batchId])
  @@index([email])
  @@index([status])
}

// Course model for coaching management
model Course {
  id                  String   @id @default(cuid())
  name                String
  description         String?
  courseType          String?  // academic, skill, certification
  mode                String   @default("offline") // offline, online, hybrid
  fee                 Float    @default(0)
  feeDescription      String?
  registrationFee     Float    @default(0)
  discountAllowed     Boolean  @default(false)
  discountPercentage  Float    @default(0)
  durationYears       Int      @default(0)
  durationMonths      Int      @default(0)
  maxInstallments     Int      @default(1)
  installmentAmounts  String?  // JSON string array of amounts
  eligibility         String?  // high_school, higher_secondary, graduation, post_graduation
  status              String   @default("active") // active, inactive
  showInAdmissionForm Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId  String
  subjects        Subject[]
  students        Student[]
  batches         Batch[]
  enquiries       Enquiry[]

  @@index([organizationId])
  @@index([status])
}

model Batch {
  id        String   @id @default(cuid())
  name      String
  description String?
  startDate DateTime?
  endDate   DateTime?
  startTime String?
  endTime   String?
  status    String   @default("active") // active, inactive, completed
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId  String
  students  Student[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId])
}

// Subject model for courses
model Subject {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId    String

  @@index([courseId])
}

model Enquiry {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String
  mobile      String
  email       String?
  description String?
  status      String   @default("new") // new, contacted, interested, admitted, lost
  source      String?  // web, referral, walk-in
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  
  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  branchId    String
  
  course      Course?  @relation(fields: [courseId], references: [id])
  courseId    String?

  @@index([organizationId])
  @@index([branchId])
  @@index([courseId])
  @@index([status])
}

// Keep Post model for future use
model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
